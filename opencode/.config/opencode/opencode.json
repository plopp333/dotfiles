{
    "$schema": "https://opencode.ai/config.json",
    "watcher": {
        "ignore": [
            "node_modules",
            "build",
            "dist",
            "target",
            "vendor",
            ".git",
            ".cache",
            ".next",
            ".turbo",
            ".venv",
            "__pycache__",
            "*.lock",
            "*.min.js",
            "*.map",
            "*.bundle.js"
        ]
    },
    "formatter": {
        "black": {
            "command": [
                "~/.local/share/nvim/mason/bin/black",
                "$FILE"
            ],
            "extensions": [
                ".py"
            ]
        }
    },
    "mcp": {
        "obsidian": {
            "type": "remote",
            "url": "http://127.0.0.1:27123/mcp/",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
            }
        }
    }
}
